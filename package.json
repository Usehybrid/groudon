{
  "name": "@hybr1d-tech/groudon",
  "version": "1.0.0",
  "description": "ZenAdmin typography: type-scale tokens and zap-* utility classes",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/groudon.css",
  "style": "./dist/groudon.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/groudon.css",
    "./groudon.css": "./dist/groudon.css",
    "./tokens.css": "./dist/tokens.css",
    "./utilities.css": "./dist/utilities.css",
    "./classes": {
      "types": "./dist/classes.d.ts",
      "default": "./dist/classes.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "keywords": [
    "css",
    "typography",
    "design-tokens"
  ],
  "author": "Soham Sarkar",
  "license": "ISC",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Usehybrid/groudon"
  },
  "publishConfig": {
    "access": "public"
  }
}
